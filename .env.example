# Existing database and internal JWT settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
TAKO_JWT_SECRET=
# Set to the existing client role ID in the shared database; do not guess it.
TAKO_CLIENT_ROLE_ID=
TAKO_DRIVER_ROLE_ID=
TAKO_API_KEY=

# Server-only private JSON downloaded from Firebase > Project settings > Service accounts.
# Mount this file as a secret; never put it in Flutter, Git, or the container image.
# If absent, Flask starts normally and firebase-login returns a clear HTTP 503.
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
